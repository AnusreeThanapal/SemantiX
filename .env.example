# Azure OpenAI Credentials for Explanation Layer (GPT-4o)
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI Credentials for Embeddings Layer (text-embedding-3-large)
# (Azure OpenAI commonly splits chat and embedding deployments)
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Database Storage Configuration
SEMANTIX_DB_PATH=semantix.db
